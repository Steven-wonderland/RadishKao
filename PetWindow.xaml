<Window x:Class="CatPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CatPet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="BubbleRow" Height="54" />
            <RowDefinition x:Name="SpriteRow" Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Bubble"
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,3"
                Padding="10,5"
                CornerRadius="11"
                Background="#F7FFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.22" Color="#000000" />
            </Border.Effect>
            <TextBlock x:Name="BubbleText"
                       FontFamily="Microsoft JhengHei UI, Segoe UI"
                       FontSize="12"
                       MaxWidth="230"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#FF2B2B2B" />
        </Border>

        <Image x:Name="Sprite"
               Grid.Row="1"
               HorizontalAlignment="Center"
               VerticalAlignment="Stretch"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</Window>
